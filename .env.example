# ─── Server ───────────────────────────────────────
PORT=3000

# ─── MongoDB Atlas (or leaves empty to use embedded NoSQL) ────
# MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/nsk_apparel?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here

# ─── Admin Credentials ────────────────────────────────────
ADMIN_EMAIL=apparelnsk@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# ─── Nodemailer / Gmail App Password ──────────────────────
# Step 1: Google Account -> Security -> 2-Step Verification
# Step 2: App Passwords -> Create new app password (16 characters)
GMAIL_USER=apparelnsk@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ─── Frontend URL ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
